{
  "compilerOptions": {
    "target": "ES2022", "module": "NodeNext", "moduleResolution": "NodeNext",
    "strict": true, "esModuleInterop": true, "skipLibCheck": true,
    "rootDir": "src", "outDir": "dist", "declaration": false,
    "noUncheckedIndexedAccess": true, "noEmitOnError": true
  },
  "include": ["src/**/*.ts"]
}
